PORT=9090
NODE_ENV=development

# MongoDB Atlas connection string (create your own cluster at mongodb.com/atlas)
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=Cluster0"

# Long random string used to sign JWTs - generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# URL of the deployed frontend, used to restrict CORS
CLIENT_URL="http://localhost:5173"
